{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/release_tag_gate.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/protect_secrets.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
